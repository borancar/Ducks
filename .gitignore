# Your copy of the game, which lives under the repository but is never part of
# it. Ducks! belongs to its authors and none of it is redistributed here.
game/

# Belt and braces: the same files again by type, so a mistake in the rule above
# is not the only thing standing between the game and a commit.
*.exe
*.egg
*.SG
*.dat
*.ico
*.URL

# Python virtualenv (113 MB, recreate with: python -m venv venv &&
# venv/bin/pip install capstone unicorn pygame-ce numpy)
venv/

# Captures and generated images from debugging sessions
debug/
shots/
*.png
*.bin
*.wav

# Run logs
*.log

# Runtime control triggers used by emulation.py
capture.request
pause.request

# Build artifact: derived from the original (copyrighted) game binary, so it is
# reproducible with unpack_ducks.py rather than tracked here.
Ducks.unpacked.exe
*.unpacked

__pycache__/
*.pyc
