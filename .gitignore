# Your copy of the game, which lives under the repository but is never part of
# it. Ducks! belongs to its authors and none of it is redistributed here.
game/

# Belt and braces: the same files again by type, so a mistake in the rule above
# is not the only thing standing between the game and a commit.
*.exe
*.egg
*.SG
*.dat
*.ico
*.URL

# Python virtualenv (113 MB, recreate with: python -m venv venv &&
# venv/bin/pip install capstone unicorn pygame-ce numpy)
venv/

# Captures and generated images from debugging sessions
debug/
shots/
*.png
*.bin
*.wav

# Run logs
*.log

# Runtime control triggers used by emulation.py
capture.request
pause.request

# Build artifact: derived from the original (copyrighted) game binary, so it is
# reproducible with unpack_ducks.py rather than tracked here.
Ducks.unpacked.exe
*.unpacked

# Machine snapshots. These hold 2 MB of guest memory, which is the game's own
# decompressed code and data - as copyrighted as the executable it came from.
# Ignored by directory and again by extension, the same belt-and-braces as game/.
snapshots/
*.snap

# Runtime control trigger for a snapshot, same idea as capture.request
snapshot.request

# The anchored one-shot scripts that apply changes to native.py. They are how a
# change is made, not part of what the repository is: each is applied once and
# discarded, and re-running one after its edit has landed fails its anchor check
# anyway. The reasoning that used to live in their docstrings goes in the commit
# message instead, where it is read.
edit_*.py

__pycache__/
*.pyc

# The control socket, created by --control-socket.
control.sock
